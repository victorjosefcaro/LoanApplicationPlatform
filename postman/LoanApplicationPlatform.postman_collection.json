		{
			"name": "02. Loan Application Lifecycle (E2E Workflow)",
			"item": [
				{
					"name": "1. Applicant - Create Loan Application",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    if (data.id) {",
									"        pm.environment.set(\"loan_application_id\", data.id.toString());",
									"        console.log(\"Saved loan_application_id: \" + data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"applicantName\": \"QA Applicant\",\n  \"amount\": 100000.00,\n  \"termInMonths\": 6,\n  \"monthlyIncome\": 45000.00,\n  \"purpose\": \"Personal Loan\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications" ]
						},
						"description": "Applicant creates a loan application. Status automatically sets to Submitted."
					},
					"response": []
				},
				{
					"name": "2. Get Loan Applications (Server-side Filter: ?status=Submitted)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications?status=Submitted&pageNumber=1&pageSize=10",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications" ],
							"query": [
								{ "key": "status", "value": "Submitted" },
								{ "key": "pageNumber", "value": "1" },
								{ "key": "pageSize", "value": "10" }
							]
						},
						"description": "Server-side filtered listing of applications by status."
					},
					"response": []
				},
				{
					"name": "3. Applicant - Resubmit Returned Application",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/submit",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "submit" ]
						},
						"description": "Resubmits an application that was marked as Returned."
					},
					"response": []
				},
				{
					"name": "4. Reviewer - Review Application (Reviewed / Returned / Rejected)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Reviewed\",\n  \"remarks\": \"Verified credit profile & employment status. OK for approval.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/review",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "review" ]
						},
						"description": "Reviewer evaluates application. Status can be set to Reviewed, Returned, or Rejected."
					},
					"response": []
				},
				{
					"name": "5. Approver - Approve Application (Approved / Returned / Rejected)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Approved\",\n  \"remarks\": \"Final approval granted.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/approve",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "approve" ]
						},
						"description": "Approver evaluates reviewed application. Status can be set to Approved, Returned, or Rejected."
					},
					"response": []
				},
				{
					"name": "6. Admin - Release Loan Funds",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/release",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "release" ]
						},
						"description": "Admin releases funds for an Approved loan. Validates Treasury balance, deducts funds, logs transaction, and generates PaymentSchedules."
					},
					"response": []
				},
				{
					"name": "7. Applicant - Cancel Application",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}" ]
						},
						"description": "Applicant cancels their loan application (only allowed in Submitted or Returned status)."
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Payment & Amortization Workflow",
			"item": [
				{
					"name": "1. Get Payment Schedules",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var list = pm.response.json();",
									"    if (list && list.length > 0) {",
									"        pm.environment.set(\"schedule_id\", list[0].id.toString());",
									"        console.log(\"Saved schedule_id: \" + list[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/payments",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "payments" ]
						},
						"description": "Fetches payment amortization schedule for a released loan."
					},
					"response": []
				},
				{
					"name": "2. Applicant - Submit Payment",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 10000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/payments/{{schedule_id}}/submit",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "payments", "{{schedule_id}}", "submit" ]
						},
						"description": "Applicant notifies payment sent, providing the submitted payment amount."
					},
					"response": []
				},
				{
					"name": "3. Admin - Post Verified Payment",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{bearer_token}}", "type": "string" } ]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 10000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loanapplications/{{loan_application_id}}/payments/{{schedule_id}}/post",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "loanapplications", "{{loan_application_id}}", "payments", "{{schedule_id}}", "post" ]
						},
						"description": "Admin posts verified payment to Treasury. Marks schedule as Paid or PartiallyPaid and credits Treasury balance."
					},
					"response": []
				}
			]
		},
