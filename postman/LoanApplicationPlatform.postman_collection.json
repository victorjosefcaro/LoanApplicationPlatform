{
	"info": {
		"_postman_id": "a8f3b210-91cd-4e89-b827-loanappplatform",
		"name": "Loan Application Platform API",
		"description": "Postman Collection for QA testing of Loan Application Platform API, including Multi-tenancy, Role-based Access Control (Applicant, Reviewer, Approver, Admin), and full Loan/Payment/Treasury workflows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"item": [
				{
					"name": "Authenticate (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var token = pm.response.text();",
									"    if (token.startsWith('\"') && token.endsWith('\"')) {",
									"        token = JSON.parse(token);",
									"    }",
									"    pm.environment.set(\"bearer_token\", token);",
									"    console.log(\"Saved bearer_token to environment.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authentication/authenticate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"authentication",
								"authenticate"
							]
						},
						"description": "Authenticates a user and automatically sets `bearer_token` in the active environment."
					},
					"response": []
				},
				{
					"name": "Register Applicant",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"applicant_qa\",\n  \"password\": \"Password123!\",\n  \"tenantId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authentication/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"authentication",
								"register"
							]
						},
						"description": "Public endpoint to register a new user with the Applicant role."
					},
					"response": []
				},
				{
					"name": "Register User (Admin Only)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bearer_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"reviewer_qa\",\n  \"password\": \"Password123!\",\n  \"role\": \"Reviewer\",\n  \"tenantId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authentication/admin/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"authentication",
								"admin",
								"register"
							]
						},
						"description": "Admin endpoint to register users with custom roles (Reviewer, Approver, Admin, Applicant)."
					},
					"response": []
				}
			]
		},
