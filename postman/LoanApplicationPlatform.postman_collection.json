							"script": {
								"exec": [
									"const baseUrl = pm.environment.get('baseUrl');",
									"const users = [",
									"    { username: 't1_applicant', varName: 'token_t1_applicant', label: 't1_applicant (Applicant, Tenant 1)' },",
									"    { username: 't1_reviewer',  varName: 'token_t1_reviewer',  label: 't1_reviewer (Reviewer, Tenant 1)' },",
									"    { username: 't1_approver',  varName: 'token_t1_approver',  label: 't1_approver (Approver, Tenant 1)' },",
									"    { username: 't1_admin',     varName: 'token_t1_admin',     label: 't1_admin (Admin, Tenant 1)' },",
									"    { username: 't2_admin',     varName: 'token_t2_admin',     label: 't2_admin (Admin, Tenant 2)' }",
									"];",
									"",
									"let index = 0;",
									"function loginNext() {",
									"    if (index >= users.length) {",
									"        pm.environment.set('bearer_token', pm.environment.get('token_t1_admin'));",
									"        pm.environment.set('active_user', 't1_admin (Admin, Tenant 1)');",
									"        console.log('🔄 All users logged in and cached! Active user set to t1_admin.');",
									"        return;",
									"    }",
									"    const user = users[index];",
									"    pm.sendRequest({",
									"        url: baseUrl + '/api/authentication/login',",
									"        method: 'POST',",
									"        header: { 'Content-Type': 'application/json' },",
									"        body: {",
									"            mode: 'raw',",
									"            raw: JSON.stringify({ username: user.username, password: 'password123' })",
									"        }",
									"    }, function (err, res) {",
									"        if (!err && res.code === 200) {",
									"            let token = res.text();",
									"            if (token.startsWith('\"') && token.endsWith('\"')) { token = JSON.parse(token); }",
									"            pm.environment.set(user.varName, token);",
									"            console.log('✅ Cached token for ' + user.username);",
									"        } else {",
									"            console.error('❌ Failed to login as ' + user.username + ': ' + (err || res.code));",
									"        }",
									"        index++;",
									"        loginNext();",
									"    });",
									"}",
									"loginNext();"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('All user tokens are cached', function () {",
									"    pm.expect(pm.environment.get('token_t1_applicant')).to.not.be.empty;",
									"    pm.expect(pm.environment.get('token_t1_reviewer')).to.not.be.empty;",
									"    pm.expect(pm.environment.get('token_t1_approver')).to.not.be.empty;",
									"    pm.expect(pm.environment.get('token_t1_admin')).to.not.be.empty;",
									"    pm.expect(pm.environment.get('token_t2_admin')).to.not.be.empty;",
									"});",
									"",
									"pm.test('Active user set to t1_admin', function () {",
									"    pm.expect(pm.environment.get('active_user')).to.include('t1_admin');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authentication/login",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "authentication", "login" ]
						},
						"description": "🔥 **One-click setup!** Logs in ALL 5 users in one shot and caches their tokens.\n\nAfter running this, you can use any ⚡ Switch request without needing to login individually.\n\nThe active user is set to `t1_admin` by default."
					},
					"response": []
				}
			],
			"description": "⚡ **Instant role switching without re-authentication!**\n\nAfter you've logged in as each user at least once (or use the '🔄 Login All Users' batch request), you can instantly switch between roles."
		},
