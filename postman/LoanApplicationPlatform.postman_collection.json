			"name": "02. ⚡ Quick Role Switch (No Re-Login!)",
			"item": [
				{
					"name": "⚡ Switch to t1_applicant",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const cached = pm.environment.get('token_t1_applicant');",
									"if (!cached) {",
									"    console.error('❌ No cached token for t1_applicant. Please login as t1_applicant first.');",
									"    throw new Error('No cached token for t1_applicant. Login first!');",
									"}",
									"pm.environment.set('bearer_token', cached);",
									"pm.environment.set('active_user', 't1_applicant (Applicant, Tenant 1)');",
									"console.log('⚡ Switched to t1_applicant (from cache)');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Role switch to t1_applicant confirmed', function () {",
									"    pm.expect(pm.environment.get('active_user')).to.include('t1_applicant');",
									"});"
								],
								"type": "text/javascript"
