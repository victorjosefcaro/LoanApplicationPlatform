						"body": {
							"mode": "raw",
							"raw": "{\n  \"applicantName\": \"Jane Doe\",\n  \"amount\": 50000.00,\n  \"termInMonths\": 12,\n  \"monthlyIncome\": 8500.00,\n  \"purpose\": \"Small Business Expansion\"\n}"
