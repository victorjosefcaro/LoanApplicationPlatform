		{
			"name": "03. Payments",
			"item": [
				{
					"name": "Get Payment Schedules",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var list = pm.response.json();",
									"    if (list && list.length > 0) {",
									"        pm.environment.set(\"schedule_id\", list[0].id);",
									"        console.log(\"Saved schedule_id:\", list[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
