			"item": [
				{
					"name": "Login (t1_applicant)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login successful (200)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var token = pm.response.text();",
									"    if (token.startsWith('\"') && token.endsWith('\"')) { token = JSON.parse(token); }",
									"    pm.environment.set('bearer_token', token);",
									"    pm.environment.set('token_t1_applicant', token);",
									"    pm.environment.set('active_user', 't1_applicant (Applicant, Tenant 1)');",
									"    console.log('✅ Logged in as t1_applicant. Token saved & cached.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
